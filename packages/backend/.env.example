# ============================================================================
# Telegram Bot Configuration
# ============================================================================

# Токен Telegram бота (обязательно)
# Получить можно у @BotFather в Telegram
BOT_TOKEN=8236353800:AAG8NcLrARgJgDm-Y0uQPrGJdbjaSPf3t0c

# ============================================================================
# Database Configuration
# ============================================================================

# URL подключения к базе данных (обязательно)
# Для PostgreSQL: postgresql://user:password@localhost:5432/dbname
# Для SQLite (dev): file:./prisma/dev.db
DATABASE_URL=postgresql://user:password@localhost:5432/weather_bot

# ============================================================================
# Weather API Configuration
# ============================================================================

# API ключ OpenWeatherMap (обязательно)
# Получить можно на https://home.openweathermap.org/api_keys
# Можно использовать WEATHER_API_KEY или OPENWEATHER_API_KEY (оба поддерживаются)
WEATHER_API_KEY=9c601c90cf7ab43656268cb2a2b70334

# Альтернативное имя для API ключа (опционально, для совместимости)
# Если указан WEATHER_API_KEY, эта переменная игнорируется
# OPENWEATHER_API_KEY=your_openweather_api_key_here

# ============================================================================
# Environment Configuration
# ============================================================================

# Окружение выполнения (опционально, по умолчанию: development)
# Возможные значения: development, production, test
NODE_ENV=development
