# Создаем .env.example с полным набором переменных
echo "BOT_TOKEN=your_telegram_bot_token_here
DATABASE_URL=file:./bot/prisma/dev.db
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_API_PROVIDER=openweathermap
WEATHER_API_LANG=ru
WEATHER_UNITS=metric
TZ=Europe/Moscow
PORT=3000
NODE_ENV=development" > .env.example