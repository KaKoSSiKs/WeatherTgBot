# Пример файла для переопределения настроек docker-compose
# Скопируйте этот файл в docker-compose.override.yml и настройте под свои нужды

version: '3.8'

services:
  backend:
    # Можно добавить дополнительные переменные окружения
    environment:
      - DEBUG=true
    # Или изменить порты
    # ports:
    #   - "3001:3000"

  frontend:
    # Можно изменить порт фронтенда
    # ports:
    #   - "5174:80"

